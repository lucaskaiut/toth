APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

HORUS_LOG_ENABLED=true
HORUS_LOG_DRIVER=horus
HORUS_LOG_BASE_URL=https://horus-api.lucaskaiut.com.br
HORUS_LOG_TOKEN=
HORUS_LOG_SOURCE=toth-api
HORUS_LOG_ENVIRONMENT=${APP_ENV}
HORUS_LOG_TIMEOUT=5

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=toth
REVERB_APP_KEY=toth-key
REVERB_APP_SECRET=toth-secret
# Laravel (container api) publica eventos neste host/porta
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Browser conecta no host (porta mapeada no docker-compose)
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

WHATSAPP_DRIVER=evolution
WHATSAPP_BASE_URL=http://evolution-api:8080
WHATSAPP_API_KEY=
WHATSAPP_TIMEOUT=30
WHATSAPP_WEBHOOK_TOKEN=

AI_DRIVER=openai_compatible
# Fallback global quando a empresa não define ai.base_url em company_configs
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=60
# Fallback global quando a empresa não define ai.model em company_configs
AI_DEFAULT_MODEL=gpt-4o-mini
AI_RECENT_MESSAGES_LIMIT=20
AI_DEBOUNCE_SECONDS=10
AI_SUMMARY_MAX_LENGTH=800

COMPANY_CONFIG_CACHE_TTL=3600
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

EMBEDDING_DRIVER=openai
OPENAI_EMBEDDING_BASE_URL="${AI_BASE_URL}"
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT=120

# Ollama local (alternativa)
# EMBEDDING_DRIVER=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

VECTOR_DB_HOST=postgres-vector
VECTOR_DB_PORT=5432
VECTOR_DB_DATABASE=toth_vectors
VECTOR_DB_USERNAME=toth
VECTOR_DB_PASSWORD=secret

KNOWLEDGE_CHUNK_SIZE_TOKENS=800
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=150
KNOWLEDGE_RETRIEVAL_TOP_K=8
KNOWLEDGE_CONTEXT_TOP_K=8
KNOWLEDGE_QUEUE=default

INTEGRATION_MAX_TOOL_ITERATIONS=5
NOX_BASE_URL=http://nox-scheduler-api
NOX_TIMEOUT=30

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
