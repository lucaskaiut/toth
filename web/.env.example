# Proxy do Vite encaminha /api para NGINX_PORT (definido no .env da raiz)
VITE_API_URL=/api

# Em produção, aponte para a URL completa da API:
# VITE_API_URL=https://api.seudominio.com/api

VITE_REVERB_APP_KEY=toth-key
VITE_REVERB_HOST=localhost
# Deve coincidir com REVERB_PORT no .env da raiz do repositório
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
