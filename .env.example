# Copie para .env e ajuste as portas conforme necessário:
#   cp .env.example .env
#
# Ao alterar portas aqui, sincronize também:
#   - api/.env  → APP_URL (NGINX_PORT), VITE_REVERB_PORT (REVERB_PORT)
#   - web/.env  → VITE_REVERB_PORT (REVERB_PORT)
# O proxy do Vite usa NGINX_PORT automaticamente via docker-compose.
#
# Portas expostas no host (docker compose)

WEB_PORT=5173
NGINX_PORT=8080
REVERB_PORT=8081
MYSQL_PORT=3306
REDIS_PORT=6379
POSTGRES_VECTOR_PORT=5433
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
